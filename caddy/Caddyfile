{$SERVER_DOMAIN} {
    handle_path /rabbitmq/* {
        reverse_proxy rabbitmq:15672

        rate_limit {
            zone dynamic_zone {
                key     {http.request.remote.host}
                events  60
                window  1m
            }
        }
    }

    handle_path /grafana/* {
        reverse_proxy grafana:3000

        rate_limit {
            zone dynamic_zone {
                key     {http.request.remote.host}
                events  60
                window  1m
            }
        }
    }

    handle_path /prometheus/* {
        reverse_proxy prometheus:9090

        rate_limit {
            zone dynamic_zone {
                key     {http.request.remote.host}
                events  60
                window  1m
            }
        }
    }

    handle_path /identity/* {
        reverse_proxy identity:8080

        rate_limit {
            zone dynamic_zone {
                key     {http.request.remote.host}
                events  30
                window  1m
            }
        }
    }

    handle_path /product/* {
        reverse_proxy product:8080

        rate_limit {
            zone dynamic_zone {
                key     {http.request.remote.host}
                events  30
                window  1m
            }
        }
    }

    handle_path /order/* {
        reverse_proxy order:8080

        rate_limit {
            zone dynamic_zone {
                key     {http.request.remote.host}
                events  30
                window  1m
            }
        }
    }

    handle_path /notification/* {
        reverse_proxy notification:8080

        rate_limit {
            zone dynamic_zone {
                key     {http.request.remote.host}
                events  30
                window  1m
            }
        }
    }

    handle_path /payment/* {
        reverse_proxy payment:8080
    }

    handle {
        abort
    }

    log {
        output stdout
        format json
    }
}